// # MCP Stdio Server - Fuzzy Matching and Ranking Engine
//
// Logline: Speaks Model Context Protocol over stdio for LLM coding agents.
//
// Setup: Requires FsReadCap. Dispatches fuzzy matching and candidate ranking tools.
//
// Beats:
//   1. Handle initialize and notifications/initialized lifecycle handshakes.
//   2. Advertise fuzzy_match and rank_candidates tools with JSON schemas.
//   3. Dispatch tools/call requests and return ranked matches.

import "score/fuzzy_score.oo";
import "score/candidate.oo";
import "ipc/json_field.oo";

fn build_error(id: String, code: Int, msg: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":" + to_string(code) + ",\"message\":\"" + json_escape(msg) + "\"}}";
}

fn build_tool_result(id: String, text: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape(text) + "\"}]}}";
}

fn split_lines(text: String) -> List[String] {
    let mut items: List[String] = list_new();
    let n: Int = chars_len(text);
    let mut cur: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(text, i);
        if c == "\n" {
            if chars_len(cur) > 0 { items = list_push(items, cur); }
            cur = "";
        } else if c == "\\" && i + 1 < n && char_at(text, i + 1) == "n" {
            if chars_len(cur) > 0 { items = list_push(items, cur); }
            cur = "";
            i = i + 1;
        } else if c != "\r" {
            cur = cur + c;
        }
        i = i + 1;
    }
    if chars_len(cur) > 0 { items = list_push(items, cur); }
    return items;
}

fn handle_tool_call(id: String, req: String) -> String {
    let params: String = json_field_raw(req, "params");
    let tool_name: String = json_field_string(params, "name");
    let args: String = json_field_raw(params, "arguments");

    if tool_name == "fuzzy_match" {
        let query: String = json_field_string(args, "query");
        let candidate: String = json_field_string(args, "candidate");
        let score: Int = fuzzy_score(candidate, query);
        let matched: Bool = if query == "" { true } else { score > 0 };
        let out: String = "{\"matched\":" + (if matched { "true" } else { "false" }) + ",\"score\":" + to_string(score) + "}";
        return build_tool_result(id, out);
    }

    if tool_name == "rank_candidates" {
        let query: String = json_field_string(args, "query");
        let raw_items: String = json_field_string(args, "items");
        let items: List[String] = split_lines(raw_items);
        let ranked: List[Candidate] = rank_items(items, query);
        let mut out: String = "";
        let n: Int = list_len(ranked);
        let mut i: Int = 0;
        while i < n {
            let c: Candidate = list_get(ranked, i);
            out = out + to_string(c.score) + "\t" + c.text + "\n";
            i = i + 1;
        }
        return build_tool_result(id, out);
    }

    return build_error(id, -32601, "unknown tool: " + tool_name);
}

fn handle_mcp_request(req: String) -> String {
    let method: String = json_field_string(req, "method");
    let raw_id: String = json_field_raw(req, "id");
    let id: String = if chars_len(raw_id) == 0 { "null" } else { raw_id };

    if method == "initialize" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"oofzf\",\"version\":\"0.1.0\"}}}";
    }
    if method == "notifications/initialized" {
        return "";
    }
    if method == "tools/list" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"tools\":[{\"name\":\"fuzzy_match\",\"description\":\"Score candidate string against query\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"},\"candidate\":{\"type\":\"string\"}},\"required\":[\"query\",\"candidate\"]}},{\"name\":\"rank_candidates\",\"description\":\"Rank newline-delimited items by fuzzy match score\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"},\"items\":{\"type\":\"string\"}},\"required\":[\"query\",\"items\"]}}]}}";
    }
    if method == "tools/call" {
        return handle_tool_call(id, req);
    }
    if method == "shutdown" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}";
    }
    return build_error(id, -32601, "method not found: " + method);
}

pub fn run_mcp_server(fs: &FsReadCap) -> Int {
    let mut buf: String = "";
    let mut running: Bool = true;
    while running {
        let mut nl: Int = str_index_of(buf, "\n");
        while nl >= 0 {
            let line: String = str_trim(str_slice(buf, 0, nl));
            buf = str_slice(buf, nl + 1, chars_len(buf));
            if chars_len(line) > 0 {
                let resp: String = handle_mcp_request(line);
                if chars_len(resp) > 0 {
                    println(resp);
                }
            }
            nl = str_index_of(buf, "\n");
        }

        let cr: Result[String, String] = oo_read_stdin_chunk(fs, 100);
        if !cr.is_ok() {
            running = false;
        } else {
            let chunk: String = match cr { Ok(s) => s, Err(_) => "" };
            if chars_len(chunk) == 0 {
                running = false;
            } else {
                buf = buf + chunk;
            }
        }
    }
    return 0;
}
