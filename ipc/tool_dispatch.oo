// # MCP Tool Dispatcher - Fuzzy Matching and Ranking Engine
//
// Logline: Dispatches Model Context Protocol tool requests for fuzzy matching and ranking.
//
// Setup: Bound to explicit &FsReadCap and &EnvCap tokens. Zero ambient authority.
//
// Beats:
//   1. Construct JSON-RPC error and tool execution envelopes.
//   2. Define JSON Schema catalogue for fuzzy_match, rank_candidates, filter_candidates, highlight_match.
//   3. Dispatch tools/call invocations and handle argument validation.

import "score/fuzzy_score.oo";
import "score/candidate.oo";
import "render/render_theme.oo";
import "ui/candidate_view.oo";
import "ipc/json_field.oo";

pub fn build_error(id: String, code: Int, msg: String) -> String {
    let safe_id: String = if chars_len(id) == 0 { "null" } else { id };
    return "{\"jsonrpc\":\"2.0\",\"id\":" + safe_id + ",\"error\":{\"code\":" + to_string(code) + ",\"message\":\"" + json_escape(msg) + "\"}}";
}

pub fn build_tool_result(id: String, text: String) -> String {
    let safe_id: String = if chars_len(id) == 0 { "null" } else { id };
    return "{\"jsonrpc\":\"2.0\",\"id\":" + safe_id + ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape(text) + "\"}]}}";
}

pub fn parse_int_safe(s: String, default_val: Int) -> Int {
    let trimmed: String = str_trim(s);
    if trimmed == "" { return default_val; }
    let n: Int = chars_len(trimmed);
    let mut is_neg: Bool = false;
    let mut start: Int = 0;
    if char_at(trimmed, 0) == "-" {
        is_neg = true;
        start = 1;
        if n == 1 { return default_val; }
    }
    let mut val: Int = 0;
    let mut i: Int = start;
    while i < n {
        let c: String = char_at(trimmed, i);
        if c == "0" { val = val * 10; }
        else if c == "1" { val = val * 10 + 1; }
        else if c == "2" { val = val * 10 + 2; }
        else if c == "3" { val = val * 10 + 3; }
        else if c == "4" { val = val * 10 + 4; }
        else if c == "5" { val = val * 10 + 5; }
        else if c == "6" { val = val * 10 + 6; }
        else if c == "7" { val = val * 10 + 7; }
        else if c == "8" { val = val * 10 + 8; }
        else if c == "9" { val = val * 10 + 9; }
        else { return default_val; }
        i = i + 1;
    }
    return if is_neg { -val } else { val };
}

pub fn split_lines(text: String) -> List[String] {
    let mut items: List[String] = list_new();
    let n: Int = chars_len(text);
    let mut cur: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(text, i);
        if c == "\n" {
            if chars_len(cur) > 0 { items = list_push(items, cur); }
            cur = "";
        } else if c == "\\" && i + 1 < n && char_at(text, i + 1) == "n" {
            if chars_len(cur) > 0 { items = list_push(items, cur); }
            cur = "";
            i = i + 1;
        } else if c != "\r" {
            cur = cur + c;
        }
        i = i + 1;
    }
    if chars_len(cur) > 0 { items = list_push(items, cur); }
    return items;
}

pub fn parse_string_array(raw: String) -> List[String] {
    let mut items: List[String] = list_new();
    let n: Int = chars_len(raw);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(raw, i);
        if c == "\"" {
            let after: Int = skip_string(raw, i);
            let s: String = json_unescape(str_slice(raw, i + 1, after - 1));
            items = list_push(items, s);
            i = after;
        } else {
            i = i + 1;
        }
    }
    return items;
}

pub fn tools_list_payload(id: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"tools\":["
        + "{\"name\":\"fuzzy_match\",\"description\":\"Score candidate string against query and return match positions\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"Search query\"},\"candidate\":{\"type\":\"string\",\"description\":\"Candidate string to match\"}},\"required\":[\"query\",\"candidate\"]}},"
        + "{\"name\":\"rank_candidates\",\"description\":\"Rank items by fuzzy match score with optional limit and threshold\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"Search query\"},\"items\":{\"description\":\"Newline-delimited string or array of candidate items\"},\"limit\":{\"type\":\"integer\",\"description\":\"Max number of results to return (default 0 for all)\"},\"threshold\":{\"type\":\"integer\",\"description\":\"Minimum score threshold (default 0)\"}},\"required\":[\"query\",\"items\"]}},"
        + "{\"name\":\"filter_candidates\",\"description\":\"Filter candidate lines matching query with optional invert\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"Search query\"},\"items\":{\"type\":\"string\",\"description\":\"Newline-delimited candidate items\"},\"invert\":{\"type\":\"boolean\",\"description\":\"Invert match to return non-matching items (default false)\"}},\"required\":[\"query\",\"items\"]}},"
        + "{\"name\":\"highlight_match\",\"description\":\"Style matched characters in candidate using ANSI escapes\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"Search query\"},\"candidate\":{\"type\":\"string\",\"description\":\"Candidate string\"},\"theme\":{\"type\":\"string\",\"description\":\"Color theme name\"}},\"required\":[\"query\",\"candidate\"]}}"
        + "]}}";
}

pub fn handle_tool_call(fs: &FsReadCap, env: &EnvCap, id: String, req: String) -> String {
    let params: String = json_field_raw(req, "params");
    let tool_name: String = json_field_string(params, "name");
    let args: String = json_field_raw(params, "arguments");

    if chars_len(tool_name) == 0 {
        return build_error(id, -32602, "missing required parameter: name");
    }

    if tool_name == "fuzzy_match" {
        if chars_len(json_field_raw(args, "query")) == 0 {
            return build_error(id, -32602, "missing required argument: query");
        }
        if chars_len(json_field_raw(args, "candidate")) == 0 {
            return build_error(id, -32602, "missing required argument: candidate");
        }
        let query: String = json_field_string(args, "query");
        let candidate: String = json_field_string(args, "candidate");
        let res: MatchResult = match_fuzzy(candidate, query);
        let out: String = "{\"matched\":" + (if res.matched { "true" } else { "false" })
            + ",\"score\":" + to_string(res.score)
            + ",\"positions\":" + format_positions_json(res.positions) + "}";
        return build_tool_result(id, out);
    }

    if tool_name == "rank_candidates" {
        if chars_len(json_field_raw(args, "query")) == 0 {
            return build_error(id, -32602, "missing required argument: query");
        }
        let raw_items: String = json_field_raw(args, "items");
        if chars_len(raw_items) == 0 {
            return build_error(id, -32602, "missing required argument: items");
        }
        let query: String = json_field_string(args, "query");
        let items: List[String] = if str_starts_with(raw_items, "[") {
            parse_string_array(raw_items)
        } else {
            split_lines(json_field_string(args, "items"))
        };
        let limit_val: Int = parse_int_safe(json_field_raw(args, "limit"), 0);
        let thresh_val: Int = parse_int_safe(json_field_raw(args, "threshold"), 0);
        let ranked: List[Candidate] = rank_items(items, query);
        let mut out: String = "";
        let n: Int = list_len(ranked);
        let mut count: Int = 0;
        let mut i: Int = 0;
        while i < n {
            let c: Candidate = list_get(ranked, i);
            if thresh_val <= 0 || c.score >= thresh_val {
                out = out + to_string(c.score) + "\t" + c.text + "\n";
                count = count + 1;
                if limit_val > 0 && count >= limit_val {
                    break;
                }
            }
            i = i + 1;
        }
        return build_tool_result(id, out);
    }

    if tool_name == "filter_candidates" {
        if chars_len(json_field_raw(args, "query")) == 0 {
            return build_error(id, -32602, "missing required argument: query");
        }
        let raw_items: String = json_field_raw(args, "items");
        if chars_len(raw_items) == 0 {
            return build_error(id, -32602, "missing required argument: items");
        }
        let query: String = json_field_string(args, "query");
        let items: List[String] = if str_starts_with(raw_items, "[") {
            parse_string_array(raw_items)
        } else {
            split_lines(json_field_string(args, "items"))
        };
        let invert: Bool = json_field_raw(args, "invert") == "true";
        let mut out: String = "";
        let n: Int = list_len(items);
        let mut i: Int = 0;
        while i < n {
            let item: String = list_get(items, i);
            let matched: Bool = if query == "" { true } else {
                let m: MatchResult = match_fuzzy(item, query);
                m.matched
            };
            if (!invert && matched) || (invert && !matched) {
                out = out + item + "\n";
            }
            i = i + 1;
        }
        return build_tool_result(id, out);
    }

    if tool_name == "highlight_match" {
        if chars_len(json_field_raw(args, "query")) == 0 {
            return build_error(id, -32602, "missing required argument: query");
        }
        if chars_len(json_field_raw(args, "candidate")) == 0 {
            return build_error(id, -32602, "missing required argument: candidate");
        }
        let query: String = json_field_string(args, "query");
        let candidate: String = json_field_string(args, "candidate");
        let theme_arg: String = json_field_string(args, "theme");
        let theme: String = if chars_len(theme_arg) > 0 { theme_arg } else { resolve_fzf_theme(fs, env) };
        let out: String = highlight_candidate_text(theme, candidate, query);
        return build_tool_result(id, out);
    }

    return build_error(id, -32601, "unknown tool: " + tool_name);
}
